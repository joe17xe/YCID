# Visit Azour — variables d'environnement
# Sans les deux variables Supabase, l'app tourne en MODE FICHIERS :
# contenu servi depuis content/*.json, /admin désactivé. C'est un mode
# de déploiement valable (jour 1), pas seulement un mode de dev.

# Projet Supabase (Settings ▸ API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Le territoire servi par cette instance (slug de la table territoires).
# La duplication, c'est ici : jeita.ezrya.fr = une instance avec jeita.
NEXT_PUBLIC_TERRITOIRE=azour

# Fond de carte vectoriel (défaut : OpenFreeMap liberty, sans clé).
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
